@page "/Exercicio04"
@model Gabriel_Fiorini_DR4_TP2_CityManager_.Pages.CityManager.Exercicio04.Exercicio04Model
@{
}

<h1>Cadastrar cidade turística</h1>

<form method="post">
    <label asp-for="Input.CityName">Nome da cidade:</label>
    <input asp-for="Input.CityName" />
    <button type="submit">Cadastrar</button>

    <div><span asp-validation-for="Input.CityName" style="color:red"></span></div>
</form>

@if (Model.Message != null)
{
    <p style="color:green"><strong>@Model.Message</strong></p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}