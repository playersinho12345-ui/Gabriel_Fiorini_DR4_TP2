@page "/{fileName?}"
@model Gabriel_Fiorini_DR4_TP2_SaveNote_.Pages.SaveNotes11Model
<h1>Anotações salvas</h1>

@if (Model.Files.Count == 0)
{
    <p>Nenhuma anotação salva ainda.</p>
}
else
{
    <ul>
        @foreach (var file in Model.Files)
        {
            <li>
                <a asp-page="/Pages/SaveNotes11" asp-route-fileName="@file">@file</a>
            </li>
        }
    </ul>
}

@if (Model.Content != null)
{
    <h2>@Model.SelectedFile</h2>
    <pre>@Model.Content</pre>
}